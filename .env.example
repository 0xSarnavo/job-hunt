# Copy to .env and fill in. One real account per vendor (PLAN §5). All free tiers.

# --- LLM tiers (src/llm.ts) — commands, space-separated, prompt appended as last arg ---
# light: free OpenCode Zen model (run `opencode auth login` once, `opencode models` to list)
# heavy: claude -p on the existing subscription. Defaults below are baked in; override here.
#LLM_LIGHT=opencode run -m opencode/nemotron-3.5-lightning-free
#LLM_HEAVY=claude -p

# --- crawl tier ---
TINYFISH_API_KEY=            # tinyfish.ai — Fetch/Search, free
FIRECRAWL_API_KEY=           # firecrawl.dev — 1,000 credits/mo, ONE account only

# --- step 4: job APIs ---
ADZUNA_APP_ID=               # developer.adzuna.com
ADZUNA_APP_KEY=
JOOBLE_API_KEY=              # jooble.org/api/about

# --- step 5: people search waterfall ---
GOOGLE_CSE_KEY=              # programmablesearchengine.google.com — 100/day
GOOGLE_CSE_CX=
BRAVE_SEARCH_API_KEY=        # brave.com/search/api

# --- step 6: email waterfall ---
HUNTER_API_KEY=
PROSPEO_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET=
GETPROSPECT_API_KEY=
FINDYMAIL_API_KEY=
REACHER_URL=http://localhost:8080   # self-hosted verifier (step 6)

# step 8 (Gmail) uses gmail-credentials.json / gmail-token.json, not env vars.
